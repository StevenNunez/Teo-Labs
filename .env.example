# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env al repositorio.

# --- IA (Genkit + Gemini) ---
# Se obtiene en https://aistudio.google.com/apikey
# src/ai/genkit.ts lee GOOGLE_GENAI_API_KEY. Ambas suelen tener el mismo valor.
GOOGLE_GENAI_API_KEY=
GEMINI_API_KEY=

# --- Supabase (opcional) ---
# Si estan vacias, src/lib/supabase.ts no inicializa el cliente y la app sigue funcionando.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Google Analytics 4 (opcional) ---
# Formato G-XXXXXXXXXX. Se saca en https://analytics.google.com (Admin > Flujos de datos).
# Si esta vacia no se carga ningun script de medicion. Ademas solo se activa
# despues de que el visitante acepta el banner de cookies.
NEXT_PUBLIC_GA_ID=

# --- Panel interno (/admin) ---
# Clave para entrar al panel. Si esta vacia, /admin queda accesible para
# cualquiera que escriba la URL.
ADMIN_PASSWORD=
