# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env al repositorio.

# --- IA (Genkit + Gemini) ---
# Se obtiene en https://aistudio.google.com/apikey
# src/ai/genkit.ts lee GOOGLE_GENAI_API_KEY. Ambas suelen tener el mismo valor.
GOOGLE_GENAI_API_KEY=
GEMINI_API_KEY=

# --- Supabase ---
# Se sacan en Project Settings > API del proyecto en supabase.com.
# El esquema de tablas esta en supabase/schema.sql: correrlo antes de usar /admin.
#
# Las dos NEXT_PUBLIC_ viajan al navegador (son publicas por diseno) y solo
# habilitan al wizard a insertar leads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# La service_role se salta Row Level Security: es la clave maestra de la base.
# NUNCA lleva prefijo NEXT_PUBLIC_ (quedaria expuesta en el navegador) y solo la
# usa el servidor para /admin y /seguimiento. Si estan vacias, el panel muestra
# instrucciones en vez de datos y el resto del sitio funciona igual.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Analytics 4 (opcional) ---
# Formato G-XXXXXXXXXX. Se saca en https://analytics.google.com (Admin > Flujos de datos).
# Si esta vacia no se carga ningun script de medicion. Ademas solo se activa
# despues de que el visitante acepta el banner de cookies.
NEXT_PUBLIC_GA_ID=

# --- Panel interno (/admin) ---
# Clave para entrar al panel. Si esta vacia, /admin queda accesible para
# cualquiera que escriba la URL.
ADMIN_PASSWORD=
